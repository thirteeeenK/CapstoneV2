APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION = pgsql
DB_HOST = 
DB_PORT = 
DB_DATABASE = 
DB_USERNAME = 
DB_PASSWORD = 

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=
AWS_URL=

# Reviews images: local-first, R2-ready — set REVIEWS_DISK=r2 + R2 creds to use Cloudflare R2
# R2 is S3-compatible: set AWS_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# and AWS_URL=https://<bucket>.<account>.r2.dev (or custom domain) — no code change needed
REVIEWS_DISK=public

VITE_APP_NAME="${APP_NAME}"

# Payment Gateway (sandbox)
# 'auto' picks stripe when STRIPE_SECRET_KEY is set, otherwise the local simulator
PAYMENT_PROVIDER=auto
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# QRPH (PayMongo) — GCash / GoTyme via QR. Set PAYMONGO keys to enable real QRPH;
# otherwise a demo QR with the actual amount is shown (no money moves).
# PayMongo test sandbox: use sk_test_... — scanning the QR opens the real
# PayMongo-hosted GCash checkout; complete "Simulate successful payment" there
# and the return URL (booking.pay.qrph.return) confirms payment — no webhook
# needed for sandbox. Live: sk_live_... + register https://<host>/webhook/payment/qrph.
# PAYMONGO_SECRET_KEY=sk_test_...
# PAYMONGO_PUBLIC_KEY=pk_test_...
# PAYMONGO_WEBHOOK_SECRET=whsk_...
# QRPH_MERCHANT_NAME=SunnyTrips
# QRPH_MERCHANT_ACCOUNT=09171234567
# QRPH_CITY=Manila

GEMINI_API_KEY=
# EMBEDDING_MODEL=models/text-embedding-001
# GEMINI_CHAT_MODEL=models/gemini-2.5-flash-lite

OPENWEATHER_API_KEY=

APP_TIMEZONE=Asia/Manila

# Demo seed mode (testing only): when true, each new signup auto-gets
# 2 pre-approved bookings (1 real + 1 TEST demo) for sandbox testing.
DEMO_MODE=false
