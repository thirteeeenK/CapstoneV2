APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
TRIP_JOURNEY_ENABLED=false
APP_URL=http://localhost

# Fallback until Admin Settings saves an account policy. false deletes immediately.
ACCOUNT_DELETION_GRACE_PERIOD=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION = pgsql
DB_HOST = 
DB_PORT = 
DB_DATABASE = 
DB_USERNAME = 
DB_PASSWORD = 

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=
AWS_URL=

# Reviews images: local-first, R2-ready — set REVIEWS_DISK=r2 + R2 creds to use Cloudflare R2
# R2 is S3-compatible: set AWS_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# and AWS_URL=https://<bucket>.<account>.r2.dev (or custom domain) — no code change needed
REVIEWS_DISK=public

VITE_APP_NAME="${APP_NAME}"

# Payment Gateway (sandbox)
# 'auto' picks stripe when STRIPE_SECRET_KEY is set, otherwise the local simulator
PAYMENT_PROVIDER=auto
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# QRPH (PayMongo) — GCash / GoTyme via QR. Set PAYMONGO keys to enable real QRPH;
# otherwise a demo QR with the actual amount is shown (no money moves).
# PayMongo test sandbox: use sk_test_... — scanning the QR opens the real
# PayMongo-hosted GCash checkout; complete "Simulate successful payment" there
# and the return URL (booking.pay.qrph.return) confirms payment — no webhook
# needed for sandbox. Live: sk_live_... + register https://<host>/webhook/payment/qrph.
# PAYMONGO_SECRET_KEY=sk_test_...
# PAYMONGO_PUBLIC_KEY=pk_test_...
# PAYMONGO_WEBHOOK_SECRET=whsk_...
# QRPH_MERCHANT_NAME=SunnyTrips
# QRPH_MERCHANT_ACCOUNT=09171234567
# QRPH_CITY=Manila

# Personal GoTyme QR (manual admin verification)
GOTYME_QR_IMAGE=images/qr_gotyme.jpg
GOTYME_ACCOUNT_NAME=
GOTYME_ACCOUNT_NUMBER=

GEMINI_API_KEY=
# EMBEDDING_MODEL=models/text-embedding-001
# GEMINI_CHAT_MODEL=models/gemini-2.5-flash-lite
# Chatbot consistency (non-secret): grounded factual answers use
# GEMINI_CHAT_GROUNDED_TEMP, general chat uses GEMINI_CHAT_CONVERSATIONAL_TEMP.
# GEMINI_CHAT_GROUNDED_TEMP=0
# GEMINI_CHAT_CONVERSATIONAL_TEMP=0.2

# OPENAI-COMPATIBLE FALLBACK (chat replies only): used when Gemini is
# missing, broken, or rate-limited. Model must be an OpenAI-compatible id
# hosted by the provider at GROQ_BASE_URL.
GROQ_API_KEY=
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

OPENWEATHER_API_KEY=

# Server-side routing. auto = OpenRouteService when OPENROUTESERVICE is set, else Valhalla.
ROUTING_PROVIDER=auto
# OpenRouteService API key (https://openrouteservice.org) — far better OSM coverage than a
# self-hosted Valhalla extract, and its routes may be drawn on the existing Leaflet/OSM map.
OPENROUTESERVICE=
# Valhalla fallback. On Railway use the Valhalla service's private domain.
VALHALLA_URL=
ROUTING_DEFAULT_MODE=walking
ROUTING_GRAPH_VERSION=western-visayas-v1
ROUTING_TIMEOUT=10
ROUTING_MATRIX_BATCH_SIZE=25
# Max distance (m) to snap a point to the nearest routable edge. Raise it for sparse island graphs
# (Boracay/El Nido) where hotels/activities sit far from mapped roads; 150 is too small for them.
ROUTING_SNAP_RADIUS_METERS=500

APP_TIMEZONE=Asia/Manila

# Demo seed mode (testing only): when true, each new signup auto-gets
# 1 approved booking (pay via sandbox) + 1 completed booking (reviewable) for sandbox testing.
DEMO_MODE=false

# ─────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH (Laravel Socialite). Create an "OAuth client ID" of type
# "Web application" at https://console.cloud.google.com/apis/credentials
# and add this redirect URI to it:  <APP_URL>/auth/google/callback
# Leave these blank to hide the "Continue with Google" button entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to APP_URL + /auth/google/callback.
GOOGLE_REDIRECT_URI=
GOOGLE_REAUTH_REDIRECT_URI=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
